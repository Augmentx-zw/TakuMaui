<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TakuMaui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TakuMaui"
    xmlns:pages="clr-namespace:TakuMaui.Pages"
    Shell.FlyoutBehavior="Flyout"
    FlyoutHeaderBehavior="Fixed"
    Title="TakuMaui">

    <Shell.FlyoutHeader>
        <Grid HeightRequest="200" BackgroundColor="{StaticResource Primary}">
            <Image Source="dotnet_bot.png"
                   HeightRequest="120"
                   VerticalOptions="Center"/>
            <Label Text="Taku Super Cool Widget Demo"
                   TextColor="White"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="End"
                   Margin="0,0,0,20"/>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Hidden Splash Page -->
    <ShellContent
        FlyoutItemIsVisible="False"
        Title="Splash"
        ContentTemplate="{DataTemplate pages:SplashPage}"
        Route="SplashPage" />

    <!-- Main Content -->
    <FlyoutItem Title="Main" FlyoutIcon="dotnet_bot.png">
        <ShellContent
            Title="Home"
            Icon="dotnet_bot.png"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
    </FlyoutItem>

    <!-- Profile Section -->
    <FlyoutItem Title="User" FlyoutIcon="dotnet_bot.png">
        <ShellContent
            Title="Profile"
            Icon="dotnet_bot.png"
            ContentTemplate="{DataTemplate pages:ProfilePage}"
            Route="ProfilePage" />
    </FlyoutItem>

    <!-- Content Section -->
    <FlyoutItem Title="Content" FlyoutIcon="dotnet_bot.png">
        <ShellContent
            Title="Images"
            Icon="dotnet_bot.png"
            ContentTemplate="{DataTemplate pages:ImagesPage}"
            Route="ImagesPage" />

        <ShellContent
            Title="Cards"
            Icon="dotnet_bot.png"
            ContentTemplate="{DataTemplate pages:CardsPage}"
            Route="CardsPage" />
    </FlyoutItem>

    <!-- Tools Section -->
    <FlyoutItem Title="Tools" FlyoutIcon="dotnet_bot.png">
        <ShellContent
            Title="Progress Bars"
            Icon="dotnet_bot.png"
            ContentTemplate="{DataTemplate pages:ProgressBarsPage}"
            Route="ProgressBarsPage" />

        <ShellContent
            Title="Tables"
            Icon="dotnet_bot.png"
            ContentTemplate="{DataTemplate pages:TablesPage}"
            Route="TablesPage" />
    </FlyoutItem>

    <Shell.FlyoutFooter>
        <StackLayout Padding="20">
            <Label Text="Version 1.0"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource Primary}"
                   FontSize="14"/>
        </StackLayout>
    </Shell.FlyoutFooter>

</Shell>