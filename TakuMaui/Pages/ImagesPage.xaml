<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TakuMaui.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:media="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui.MediaElement"
             xmlns:converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
             x:Class="TakuMaui.Pages.ImagesPage"
             Title="Media">

    <Grid>
        <CollectionView x:Name="MediaCollection"
                       ItemsSource="{Binding MediaItems}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" 
                                 ItemSpacing="0" />
            </CollectionView.ItemsLayout>
            
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:MediaItem">
                    <Grid HeightRequest="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=Height}">
                        
                        <!-- Image View -->
                        <Image Source="{Binding FilePath}"
                               Aspect="AspectFill"
                               IsVisible="{Binding Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:MediaType.Image}}"/>
                        
                        <!-- Video View -->
                        <media:MediaElement 
                            Source="{Binding FilePath}"
                            Aspect="AspectFit"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            ShouldAutoPlay="True" 
                            ShouldLoopPlayback="True"
                            ShouldShowPlaybackControls="True"
                            ShouldKeepScreenOn="True"
                            MediaFailed="OnMediaFailed"
                            MediaOpened="OnMediaOpened"/>

                        <!-- Common Overlay -->
                        <VerticalStackLayout Padding="20"
                                           VerticalOptions="End"
                                           BackgroundColor="#80000000">
                            <Label Text="{Binding Title}"
                                   TextColor="White"
                                   FontSize="20"
                                   FontAttributes="Bold"/>
                            <Label Text="{Binding Description}"
                                   TextColor="White"
                                   FontSize="16"/>
                            <Grid ColumnDefinitions="Auto,*,Auto" 
                                  Margin="0,10,0,0">
                                <Label Text="{Binding Author}"
                                       TextColor="White"
                                       FontSize="14"/>
                                <Label Text="{Binding CaptureDate, StringFormat='{0:d}'}"
                                       Grid.Column="1"
                                       TextColor="White"
                                       FontSize="14"
                                       HorizontalOptions="Center"/>
                                <HorizontalStackLayout Grid.Column="2" 
                                                     Spacing="5">
                                    <Label Text="❤️"
                                           FontSize="16"
                                           VerticalOptions="Center"/>
                                    <Label Text="{Binding Likes}"
                                           TextColor="White"
                                           FontSize="14"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="Back"
                Clicked="OnBackClicked"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                Margin="20"
                BackgroundColor="#80000000"
                TextColor="White"/>
    </Grid>

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:EnumToBoolConverter x:Key="EnumToBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

</ContentPage>