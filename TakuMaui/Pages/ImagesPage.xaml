<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TakuMaui.Models"
             x:Class="TakuMaui.Pages.ImagesPage"
             Title="Images">

    <Grid>
        <CollectionView x:Name="ImagesCollection"
                       ItemsSource="{Binding Images}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" 
                                 ItemSpacing="0" />
            </CollectionView.ItemsLayout>
            
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ImageItem">
                    <Grid HeightRequest="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=Height}">
                        <Image Source="{Binding FilePath}"
                               Aspect="AspectFill"/>
                        
                        <VerticalStackLayout Padding="20"
                                           VerticalOptions="End">
                            <Label Text="{Binding Title}"
                                   TextColor="White"
                                   FontSize="20"
                                   FontAttributes="Bold"/>
                            <Label Text="{Binding Description}"
                                   TextColor="White"
                                   FontSize="16"/>
                            <Grid ColumnDefinitions="Auto,*,Auto" 
                                  Margin="0,10,0,0">
                                <Label Text="{Binding Author}"
                                       TextColor="White"
                                       FontSize="14"/>
                                <Label Text="{Binding CaptureDate, StringFormat='{0:d}'}"
                                       Grid.Column="1"
                                       TextColor="White"
                                       FontSize="14"
                                       HorizontalOptions="Center"/>
                                <HorizontalStackLayout Grid.Column="2" 
                                                     Spacing="5">
                                    <Label Text="❤️"
                                           FontSize="16"
                                           VerticalOptions="Center"/>
                                    <Label Text="{Binding Likes}"
                                           TextColor="White"
                                           FontSize="14"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="Back"
                Clicked="OnBackClicked"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                Margin="20"
                BackgroundColor="#80000000"
                TextColor="White"/>
    </Grid>
</ContentPage>